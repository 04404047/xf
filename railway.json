{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "echo 'zero-dependency node app, no build step'"
  },
  "deploy": {
    "startCommand": "node app-server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  },
  "volumes": [
    {
      "name": "recycleflow-data",
      "mountPath": "/data",
      "size": 1
    }
  ],
  "env": {
    "SYNC_DATA_FILE": "/data/sync-data.json"
  }
}
